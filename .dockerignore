# Anything the Docker build does not need — trims build context from
# ~hundreds of MB down to a few MB and speeds up every deploy.

# Dependencies (will be reinstalled inside the container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (rebuilt inside the container)
.next
out

# Version control
.git
.gitignore
.gitattributes

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Local env files — never ship these into an image
.env
.env.local
.env.*.local

# Tests and docs we don't need at runtime
coverage
.nyc_output
*.md
!README.md

# Misc
.turbo
.cache
*.log
